<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SlimRead</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both come from the build settings. Hardcoding them here meant the
	     MARKETING_VERSION the release workflow passes was silently dropped,
	     and every published build reported itself as 1.0 on the phone. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ============================================================
	     THE IMPORTANT PART
	     UIStatusBarHidden hides it during the launch screen.
	     UIViewControllerBasedStatusBarAppearance = YES lets
	     BrowserViewController.prefersStatusBarHidden keep it hidden
	     afterwards, in every orientation including portrait.
	     ============================================================ -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- ProMotion. Without this iOS caps the app - including WKWebView scrolling
	     and every UIView animation - at 60fps on 120Hz hardware. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- ============================================================
	     Background tweaks refresh.
	     Pulls tweaks/ while the app is closed so the newest copy is
	     already stored when it opens - otherwise the fetch races the
	     first page load and the page has to be reloaded once the new
	     script arrives. Purely an optimisation: iOS decides whether
	     these ever run, and the reload path remains the guarantee.
	     The identifier must match AppDelegate.refreshTaskID.
	     ============================================================ -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.example.slimread.tweaks-refresh</string>
	</array>

	<key>UILaunchScreen</key>
	<dict/>

	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Allows plain-http sites if you ever browse somewhere other than Tapas. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
